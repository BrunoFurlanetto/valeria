# Groq API (obrigatorio para chat e STT)
GROQ_API_KEY=

# ElevenLabs API (necessario para TTS dinamico; opcional — sem isso usa fallback estatico)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Configuracao do assistente (todos opcionais — valores abaixo sao os defaults)
VALERIA_ASSISTANT_NAME=Valeria

# Groq — modelos
VALERIA_GROQ_CHAT_MODEL=openai/gpt-oss-20b
VALERIA_GROQ_CHAT_FALLBACK_MODEL=qwen/qwen3-32b
VALERIA_GROQ_STT_MODEL=whisper-large-v3-turbo

# ElevenLabs — modelo
VALERIA_ELEVENLABS_MODEL=eleven_flash_v2_5

# Audio local
VALERIA_AUDIO_OUTPUT_DIR=tmp/valeria-audio
VALERIA_COMMAND_RECORD_SECONDS=5
VALERIA_COMMAND_SAMPLE_RATE=16000
VALERIA_TTS_SAMPLE_RATE=24000
